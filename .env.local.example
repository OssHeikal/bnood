# Copy to .env.local (local Herd backend) or .env.prod (production API). Both are gitignored.
# Used by VS Code launch configs via --dart-define-from-file; run fails if the listed file is missing.

# API base URL. Local Herd: http://bnood.test/api  |  Production: https://bnoodapp.com/api
BNOOD_API_BASE_URL=http://bnood.test/api

# development | production (also used as the Sentry environment)
BNOOD_APP_ENV=development

# AppsFlyer (get the dev key from the AppsFlyer dashboard; never commit it)
APPSFLYER_DEV_KEY=
APPSFLYER_IOS_APP_ID=6832033457

# Debug/profile builds default to false, release to true. Keep false locally to avoid polluting analytics.
ANALYTICS_ENABLED=false

# Optional: Sentry DSN (leave empty to disable)
SENTRY_DSN=
